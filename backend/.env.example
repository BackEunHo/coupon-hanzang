DB_PASSWORD=replace-with-a-long-random-password
APP_ALLOWED_ORIGIN=http://localhost:8080
APP_COOKIE_SECURE=false
APP_PHONE_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
APP_PHONE_LOOKUP_KEY=replace-with-a-different-openssl-rand-base64-32

# Each key must be a different openssl rand -base64 32 result.
APP_CUSTOMER_PHONE_ENCRYPTION_KEY=replace-with-a-different-32-byte-key
APP_CUSTOMER_PHONE_LOOKUP_KEY=replace-with-a-different-32-byte-key
APP_COUPON_CODE_ENCRYPTION_KEY=replace-with-a-different-32-byte-key
APP_COUPON_CODE_MAC_KEY=replace-with-a-different-32-byte-key
# Development example. Set the public quota before production.
APP_MONTHLY_MESSAGE_LIMIT=100

# SOLAPI: keep sending disabled until the recipient and trial volume are confirmed.
SOLAPI_SEND_ENABLED=false
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_FROM_NUMBER=
SOLAPI_WEBHOOK_SECRET=
SOLAPI_ALLOWED_RECIPIENTS=
SOLAPI_ALLOW_ALL_RECIPIENTS=false
SOLAPI_COUNT_DELIVERY_FAILURES=true
SOLAPI_MAX_SENDS_PER_RUN=1
SOLAPI_BACKGROUND_ENABLED=true
